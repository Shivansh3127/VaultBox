// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Stage 0: bare upload ────────────────────────────────────────────────────

model File {
  id         String   @id @default(uuid())
  filename   String
  size       Int      // bytes
  owner      String   // from X-User-Id header
  storageKey String   // MinIO object key  e.g. "files/<uuid>/<filename>"
  mimeType   String?
  createdAt  DateTime @default(now())

  @@map("files")
}
