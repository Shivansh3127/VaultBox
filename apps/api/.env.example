# ──────────────────────────────────────────────
# .env.example — Copy to .env and fill in values
# NEVER commit .env to Git
# ──────────────────────────────────────────────

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://vaultbox:vaultbox_secret@localhost:5433/vaultbox_db"

# moto server — S3-compatible object store (matches docker-compose.yml s3mock service)
# Any non-empty key works; moto does not validate credentials
S3_ENDPOINT=localhost
S3_PORT=4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=vaultbox
S3_REGION=us-east-1

# Express server port (4000 — SimpleCI owns 3000)
PORT=4000

# Node environment
NODE_ENV=development
